{
  "about": "How many `to` are in one `from` for an item with these `conversions` ([from, to, factor]: 1 from = factor to). Both the service (Go) and the app (TypeScript) run these cases, so the grocery list the app previews offline matches the one the service saves. `factor` null means the units don't convert. Compare factors with a relative tolerance of 1e-9.",
  "units": [
    { "code": "piece", "base": "piece", "baseSize": 1 },
    { "code": "dozen", "base": "piece", "baseSize": 12 },
    { "code": "kg", "base": "g", "baseSize": 1000 },
    { "code": "g", "base": "g", "baseSize": 1 },
    { "code": "l", "base": "ml", "baseSize": 1000 },
    { "code": "ml", "base": "ml", "baseSize": 1 },
    { "code": "pack" },
    { "code": "box" },
    { "code": "bottle" },
    { "code": "cup", "base": "ml", "baseSize": 240 },
    { "code": "tbsp", "base": "ml", "baseSize": 15 },
    { "code": "tsp", "base": "ml", "baseSize": 5 },
    { "code": "head" },
    { "code": "clove" }
  ],
  "cases": [
    { "name": "a unit is one of itself", "conversions": [], "from": "box", "to": "box", "factor": 1 },
    { "name": "standard: kg to g", "conversions": [], "from": "kg", "to": "g", "factor": 1000 },
    { "name": "standard: g to kg", "conversions": [], "from": "g", "to": "kg", "factor": 0.001 },
    { "name": "standard: cup to tbsp", "conversions": [], "from": "cup", "to": "tbsp", "factor": 16 },
    { "name": "standard: tbsp to tsp", "conversions": [], "from": "tbsp", "to": "tsp", "factor": 3 },
    { "name": "standard: L to cup", "conversions": [], "from": "l", "to": "cup", "factor": 4.166666666666667 },
    { "name": "standard: dozen to piece", "conversions": [], "from": "dozen", "to": "piece", "factor": 12 },
    { "name": "weight and volume don't convert on their own", "conversions": [], "from": "g", "to": "ml", "factor": null },
    { "name": "a unit without a size needs a rule", "conversions": [], "from": "box", "to": "piece", "factor": null },
    { "name": "butter: an item's rule", "conversions": [["pack", "g", 200], ["tbsp", "g", 14]], "from": "pack", "to": "g", "factor": 200 },
    { "name": "butter: a rule backwards", "conversions": [["pack", "g", 200], ["tbsp", "g", 14]], "from": "g", "to": "pack", "factor": 0.005 },
    { "name": "butter: a rule, then standard", "conversions": [["pack", "g", 200], ["tbsp", "g", 14]], "from": "pack", "to": "kg", "factor": 0.2 },
    { "name": "butter: standard, then a rule", "conversions": [["pack", "g", 200], ["tbsp", "g", 14]], "from": "cup", "to": "g", "factor": 224 },
    { "name": "butter: from one rule to the other", "conversions": [["pack", "g", 200], ["tbsp", "g", 14]], "from": "tbsp", "to": "pack", "factor": 0.07 },
    { "name": "garlic: two rules in a row", "conversions": [["head", "clove", 10], ["clove", "g", 5]], "from": "head", "to": "g", "factor": 50 },
    { "name": "garlic: two rules, then standard", "conversions": [["head", "clove", 10], ["clove", "g", 5]], "from": "head", "to": "kg", "factor": 0.05 },
    { "name": "garlic: cloves in a head, backwards", "conversions": [["head", "clove", 10], ["clove", "g", 5]], "from": "clove", "to": "head", "factor": 0.1 },
    { "name": "bell pepper: g as a stepping stone to kg", "conversions": [["piece", "g", 150]], "from": "piece", "to": "kg", "factor": 0.15 },
    { "name": "bell pepper: dozen through piece and g", "conversions": [["piece", "g", 150]], "from": "dozen", "to": "kg", "factor": 1.8 },
    { "name": "olive oil: tbsp in a bottle", "conversions": [["bottle", "ml", 750]], "from": "bottle", "to": "tbsp", "factor": 50 },
    { "name": "olive oil: 2 tbsp is 0.04 bottle", "conversions": [["bottle", "ml", 750]], "from": "tbsp", "to": "bottle", "factor": 0.02 },
    { "name": "milk: a bottle as a litre", "conversions": [["bottle", "l", 1]], "from": "bottle", "to": "ml", "factor": 1000 },
    { "name": "yogurt: pots in a pack, then g", "conversions": [["pack", "piece", 4], ["piece", "g", 125]], "from": "pack", "to": "g", "factor": 500 },
    { "name": "lemons: one item, two dimensions", "conversions": [["piece", "g", 100], ["piece", "tbsp", 3]], "from": "g", "to": "tsp", "factor": 0.09 },
    { "name": "eggs: still no box without a rule", "conversions": [["pack", "piece", 6]], "from": "box", "to": "piece", "factor": null },
    { "name": "rules for other units don't help", "conversions": [["head", "clove", 10]], "from": "pack", "to": "g", "factor": null }
  ]
}
