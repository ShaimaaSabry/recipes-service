{
    "swagger": "2.0",
    "info": {
        "description": "Recipes, grocery items and the grocery list for the MamieNellie app.",
        "title": "MamieNellie API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/v1",
    "paths": {
        "/recipes": {
            "get": {
                "tags": [
                    "recipes"
                ],
                "summary": "List recipes",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Owner of the data",
                        "name": "X-Device-Id",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.recipeDTO"
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "recipes"
                ],
                "summary": "Create a recipe",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Owner of the data",
                        "name": "X-Device-Id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Create recipe payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.createRecipeRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/api.recipeDTO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.createRecipeRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "id": {
                    "description": "ID is optional; the app sends the one it created, possibly while offline.",
                    "type": "string",
                    "maxLength": 64
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "api.recipeDTO": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        }
    }
}