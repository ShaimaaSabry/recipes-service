                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.appleSignInRequest": {
            "type": "object",
            "required": [
                "idToken"
            ],
            "properties": {
                "idToken": {
                    "description": "IDToken is the identityToken from Sign in with Apple.",
                    "type": "string"
                },
                "name": {
                    "description": "Name is the full name Apple shows the app on the first sign-in only. Optional.",
                    "type": "string",
                    "maxLength": 200
                }
            }
        },
        "api.catalogDTO": {
            "type": "object",
            "properties": {
                "categories": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/api.categoryDTO"
                    }
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/api.itemDTO"
                    }
                },
                "units": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/api.unitDTO"
                    }
                }
            }
        },
        "api.categoryDTO": {
            "type": "object",
            "properties": {
                "emoji": {
                    "type": "string",
                    "example": "🥕"
                },
                "hidden": {
                    "type": "boolean"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "example": "Produce"
                },
                "source": {
                    "type": "string",
                    "enum": [
                        "system",
                        "user"
                    ]
                }
            }
        },
        "api.categoryRequest": {
            "type": "object",
            "required": [
                "emoji",
                "name"
            ],
            "properties": {
                "emoji": {
                    "type": "string",
                    "example": "🧊"
                },
                "name": {
                    "type": "string",
                    "example": "Frozen"
                }
            }
        },
        "api.conversionDTO": {
            "type": "object",
            "required": [
                "factor",
                "fromUnitId",
                "toUnitId"
            ],
            "properties": {
                "factor": {
                    "type": "number",
                    "example": 10
                },
                "fromUnitId": {
                    "type": "string",
                    "example": "01a19182-b211-7207-a87a-4bec8f271f32"
                },
                "toUnitId": {
                    "type": "string",
                    "example": "01a19182-b211-7226-8fd7-e7f5ebfa367e"
                }
            }
        },
        "api.createItemRequest": {
            "type": "object",
            "required": [
                "buyUnitIds",
                "categoryId",
                "emoji",
                "name"
            ],
            "properties": {
                "buyUnitIds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                },
                "categoryId": {
                    "type": "string"
                },
                "conversions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/api.conversionDTO"
                    }
                },
                "cookUnitIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "emoji": {
                    "type": "string",
                    "example": "🧄"
                },
                "name": {
                    "type": "string",
                    "example": "Black garlic"
                }
            }
        },
        "api.createRecipeRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "id": {
