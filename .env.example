# Copy to .env.local for local development (it is gitignored). In prod these come from the
# platform's environment and AWS Secrets Manager, never from a file.

# local or prod
APP_ENV=local
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:4444/recipes?sslmode=disable

# Signs access tokens: at least 32 characters. Any value works locally; in prod it's a random
# secret in AWS Secrets Manager (openssl rand -base64 48).
JWT_SIGNING_KEY=local-development-signing-key-not-for-prod
# Comma-separated. Not needed locally, where POST /v1/auth/dev signs in without Apple or Google.
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=

# Recipe photos: the S3 bucket the app uploads to and the CloudFront address that serves them.
# Leave both empty locally to run without photos (uploads then answer 503); set both to try them
# against a real bucket with your own AWS credentials.
PHOTOS_BUCKET=
PHOTOS_URL=
